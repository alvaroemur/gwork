erDiagram
    CLIENTE        ||--||  MANIFIESTO          : "declara"
    CLIENTE        ||--o|  ESTADO              : "acumula en"
    CLIENTE        ||--o|  DECISIONES          : "tiene pendientes en"
    CLIENTE        ||--o{  PREVIEW_ARTEFACTO   : "genera"

    MANIFIESTO     ||--o{  ITEM                : "lista"
    ITEM           ||--o{  TRANSFORM           : "aplica"
    ITEM           ||--o|  SHEET_CONFIG        : "configura como"
    ITEM           ||--o|  SHEET_SNAPSHOT      : "tiene snapshot en"
    ITEM           ||--o|  DOC_SNAPSHOT        : "tiene snapshot en"
    ITEM           ||--o|  SLIDES_SNAPSHOT     : "tiene snapshot en"

    SHEET_SNAPSHOT ||--o{  ROW                 : "captura"
    ROW            ||--|{  CELDA               : "compuesta de"

    DECISIONES     ||--o{  PENDIENTE_CELDA     : "lista"
    DECISIONES     ||--o{  DRIFT_ESTRUCTURAL   : "lista"
    PENDIENTE_CELDA }o--|| ITEM                : "refiere a"
    DRIFT_ESTRUCTURAL }o--|| ITEM              : "refiere a"

    PREVIEW_ARTEFACTO }o--|| ITEM              : "deriva de"

    DESIGN_SYSTEM  ||--|{  STYLE_RULE          : "define"
    STYLE_RULE     }o--||  ITEM                : "aplica a tipo de"

    APPS_SCRIPT_TEMPLATE }o--|| ITEM           : "se bindea a tipo de"

    CLIENTE {
        string slug PK
        string ruta_local
    }
    MANIFIESTO {
        string cliente_slug PK,FK
        string drive_folder_id
    }
    ITEM {
        string id PK
        string cliente_slug FK
        string local_path UK
        string drive_id
        enum   tipo "sheet - doc - slides"
        list   transforms
    }
    SHEET_CONFIG {
        string item_id PK,FK
        string sheet_tab "nullable - default primera pestana"
        int    headers_row "default 1"
        int    data_start_row "default 2"
        int    data_end_row "nullable"
        string key_column "nullable"
        enum   sync_mode "values_patch - replace"
    }
    TRANSFORM {
        string id PK
        string item_id FK
        enum   nombre "strip_internal - rewrite_links"
        json   config
    }
    ESTADO {
        string cliente_slug PK,FK
        datetime last_apply
    }
    SHEET_SNAPSHOT {
        string item_id PK,FK
        datetime applied_at
        string   remote_modified_time
        string   local_hash
        json     headers
        string   values_hash
    }
    DOC_SNAPSHOT {
        string item_id PK,FK
        datetime applied_at
        string   remote_modified_time
        string   local_hash
        int      word_count "nullable"
    }
    SLIDES_SNAPSHOT {
        string item_id PK,FK
        datetime applied_at
        string   remote_modified_time
        string   local_hash
        int      slide_count "nullable"
    }
    ROW {
        string item_id PK,FK
        string row_key PK
        int    row_index
    }
    CELDA {
        string item_id PK,FK
        string row_key PK,FK
        string columna PK
        string valor
    }
    DECISIONES {
        string cliente_slug PK,FK
        datetime generated_at
    }
    PENDIENTE_CELDA {
        string id PK
        string item_id FK
        string row_key
        string columna
        string valor_snapshot
        string valor_local
        string valor_remoto
        string nota "nullable"
        json   comentarios
        enum   decision "pending - remote - local - skip"
    }
    DRIFT_ESTRUCTURAL {
        string id PK
        string item_id FK
        string descripcion
        enum   decision "pending - skip - abort_item"
    }
    PREVIEW_ARTEFACTO {
        string id PK
        string item_id FK
        enum   tipo "md_transformado - values_json - pulled_csv - docx_intermedio - pptx_intermedio"
        string path
    }
    DESIGN_SYSTEM {
        string id PK
        string nombre
        string version
        string path "ruta a claude-design.yaml"
    }
    STYLE_RULE {
        string id PK
        string design_system_id FK
        enum   target_tipo "sheet - doc - slides"
        enum   elemento "heading1 - heading2 - tabla - celda_header - body - paleta"
        json   estilos "font - size - color - bold - background"
    }
    APPS_SCRIPT_TEMPLATE {
        string id PK
        enum   target_tipo "sheet - doc - slides"
        string nombre_menu
        json   acciones "lista de funciones del menu contextual"
        string script_source "ruta al template gs"
    }
