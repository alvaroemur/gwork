erDiagram
    CLIENT ||--|| MANIFEST : "declares"
    CLIENT ||--o| STATE : "accumulates"
    CLIENT ||--o| DECISIONS : "has pending"
    CLIENT ||--o{ PREVIEW_ARTIFACT : "generates"

    MANIFEST ||--o{ ITEM : "lists"
    ITEM ||--o{ TRANSFORM : "applies"
    ITEM ||--o| SHEET_CONFIG : "configures"
    ITEM ||--o| SHEET_SNAPSHOT : "has snapshot"
    ITEM ||--o| DOC_SNAPSHOT : "has snapshot"
    ITEM ||--o| SLIDES_SNAPSHOT : "has snapshot"

    SHEET_SNAPSHOT ||--o{ ROW : "captures"
    ROW ||--|{ CELL : "contains"

    DECISIONS ||--o{ PENDING_CELL : "lists"
    DECISIONS ||--o{ STRUCTURAL_DRIFT : "lists"
    PENDING_CELL }o--|| ITEM : "references"
    STRUCTURAL_DRIFT }o--|| ITEM : "references"

    PREVIEW_ARTIFACT }o--|| ITEM : "derives from"
    DESIGN_SYSTEM ||--|{ STYLE_RULE : "defines"
    STYLE_RULE }o--|| ITEM : "applies to item type"
    APPS_SCRIPT_TEMPLATE }o--|| ITEM : "binds to item type"

    CLIENT {
        string slug PK
        string local_path
    }
    MANIFEST {
        string client_slug PK,FK
        string drive_folder_id
    }
    ITEM {
        string id PK
        string client_slug FK
        string local_path UK
        string drive_id
        enum type "sheet - doc - slides"
        list transforms
    }
    SHEET_CONFIG {
        string item_id PK,FK
        string sheet_tab "nullable - first tab by default"
        int headers_row "default 1"
        int data_start_row "default 2"
        int data_end_row "nullable"
        string key_column "nullable"
        enum sync_mode "values_patch - replace"
    }
    TRANSFORM {
        string id PK
        string item_id FK
        enum name "strip_internal - rewrite_links"
        json config
    }
    STATE {
        string client_slug PK,FK
        datetime last_apply
    }
    SHEET_SNAPSHOT {
        string item_id PK,FK
        datetime applied_at
        string remote_modified_time
        string local_hash
        json headers
        string values_hash
    }
    DOC_SNAPSHOT {
        string item_id PK,FK
        datetime applied_at
        string remote_modified_time
        string local_hash
        int word_count "nullable"
    }
    SLIDES_SNAPSHOT {
        string item_id PK,FK
        datetime applied_at
        string remote_modified_time
        string local_hash
        int slide_count "nullable"
    }
    ROW {
        string item_id PK,FK
        string row_key PK
        int row_index
    }
    CELL {
        string item_id PK,FK
        string row_key PK,FK
        string column PK
        string value
    }
    DECISIONS {
        string client_slug PK,FK
        datetime generated_at
    }
    PENDING_CELL {
        string id PK
        string item_id FK
        string row_key
        string column
        string snapshot_value
        string local_value
        string remote_value
        string note "nullable"
        json comments
        enum decision "pending - remote - local - skip"
    }
    STRUCTURAL_DRIFT {
        string id PK
        string item_id FK
        string description
        enum decision "pending - skip - abort_item"
    }
    PREVIEW_ARTIFACT {
        string id PK
        string item_id FK
        enum type "transformed_md - values_json - pulled_csv - intermediate_docx - intermediate_pptx"
        string path
    }
    DESIGN_SYSTEM {
        string id PK
        string name
        string version
        string path "path to .gwork.yaml"
    }
    STYLE_RULE {
        string id PK
        string design_system_id FK
        enum target_type "sheet - doc - slides"
        enum element "heading1 - heading2 - table - header_cell - body - palette"
        json styles "font - size - color - bold - background"
    }
    APPS_SCRIPT_TEMPLATE {
        string id PK
        enum target_type "sheet - doc - slides"
        string menu_name
        json actions "context-menu function list"
        string script_source "path to gs template"
    }
