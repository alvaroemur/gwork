flowchart TB

%% cowork-drivesync - flujo plan → revisión humana → apply · nivel 2
%% Tres procesos coreografiados conectados por eventos sobre decisions.yaml.
%% Nota de diseño: el write-back hacia CSV local (lo que antes pensamos como `cowork sync pull`)
%% queda integrado en `apply`, porque con merge celda-a-celda push y pull-back ocurren
%% en la misma transacción atómica por item.
%%
%% Leyenda:
%%   [paso]            actividad
%%   {X condicion?}    gateway exclusivo
%%   ([trigger])       inicio/fin
%%   [(store)]         data store persistente interno
%%   [(store)] dashed  data store externo
%%   -->               flujo de control
%%   -.->              flujo de datos

    %% =========================================
    %%  S1 · sync plan · agente automático
    %% =========================================
    subgraph SPlan[" 1 · sync plan · agente "]
        direction TB
        PlanIni([cowork sync plan mifondo])
        Cargar[Cargar manifiesto · state · token]
        IterPlan[Iterar items del manifiesto]
        TipoPlan{X tipo de item?}

        FetchSheet[Fetch Sheets API · valores · fórmulas · notas · comentarios · headers]
        DiffStruct{X estructura == snapshot?}
        RegDrift[Registrar drift estructural]
        DiffCel[Diff celda a celda · LOCAL · SNAPSHOT · REMOTE]
        ClasCel{X clasificación de celda?}
        AutoForm[Auto-aceptar remoto · cambio derivado de fórmula]
        PlanPush[Planificar push de celda]
        PlanWB[Planificar write-back a CSV local]
        RegPend[Registrar pendiente con contexto · nota · comentarios]

        FetchDoc[Fetch modifiedTime del Doc]
        DiffDoc{X Doc modificado remotamente tras last_apply?}
        RegDriftDoc[Registrar drift de Doc]
        Transforms[Aplicar transforms · strip_internal · rewrite_links]
        EscribMd[Escribir MD transformado en preview/]

        EscribSal[Escribir preview/ · decisions.yaml]
        PlanFin([fin de plan])
    end

    %% =========================================
    %%  S2 · revisión humana vía agente
    %% =========================================
    subgraph SRev[" 2 · revisión humana vía agente "]
        direction TB
        RevIni([decisions.yaml con pendientes])
        Resumir[Agente resume pendientes y drifts al usuario en batch]
        Responder[Usuario responde en batch · remote · local · skip · abort_item]
        Editar[Agente escribe resoluciones en decisions.yaml]
        RevFin([decisions resueltas])
    end

    %% =========================================
    %%  S3 · sync apply · agente automático
    %% =========================================
    subgraph SApply[" 3 · sync apply · agente "]
        direction TB
        AppIni([cowork sync apply mifondo])
        VerifPend{X quedan pendientes sin resolver?}
        AbortP([abort · pedir re-plan])
        Revalidar[Re-fetch Drive · validar no cambió desde plan]
        Carrera{X snapshot remoto == lo visto en plan?}
        AbortC([abort item · race detectada])
        IterApply[Iterar items con cambios]
        TipoApply{X tipo de item?}

        Matriz[Construir matriz final · combina auto-merge + decisiones]
        BatchUp[batchUpdate de celdas push hacia Drive]
        WriteBack[Reescribir CSV local · celdas remote aceptadas]

        LeerMd[Leer MD transformado desde preview/]
        Pandoc[Pandoc · MD a docx]
        UploadDoc[Upload docx · update sobre drive_id]

        UpdSnap[Actualizar snapshot en state.json]
        AppFin([fin de apply])
    end

    %% =========================================
    %%  Stores (cuelgan lateralmente)
    %% =========================================
    Manifest[(.drivesync.yaml)]
    State[(.drivesync.state.json)]
    Preview[(.drivesync/preview/)]
    Decisions[(decisions.yaml)]
    LocalFiles[(CSV + MD locales)]
    Drive[(Google Drive · Sheets · Docs)]

    %% =========================================
    %%  Flujo de control · plan
    %% =========================================
    PlanIni --> Cargar --> IterPlan --> TipoPlan
    TipoPlan -- "sheet" --> FetchSheet
    TipoPlan -- "doc"   --> FetchDoc

    FetchSheet --> DiffStruct
    DiffStruct -- "drift" --> RegDrift --> EscribSal
    DiffStruct -- "sí"    --> DiffCel --> ClasCel
    ClasCel -- "edited / clean"           --> PlanPush     --> EscribSal
    ClasCel -- "clean / edited · fórmula" --> AutoForm     --> PlanWB --> EscribSal
    ClasCel -- "clean / edited · sin fórmula" --> RegPend  --> EscribSal
    ClasCel -- "edited / edited"          --> RegPend

    FetchDoc --> DiffDoc
    DiffDoc -- "sí" --> RegDriftDoc --> EscribSal
    DiffDoc -- "no" --> Transforms --> EscribMd --> EscribSal

    EscribSal --> PlanFin

    %% =========================================
    %%  Flujo de control · revisión humana
    %% =========================================
    RevIni --> Resumir --> Responder --> Editar --> RevFin

    %% =========================================
    %%  Flujo de control · apply
    %% =========================================
    AppIni --> VerifPend
    VerifPend -- "sí" --> AbortP
    VerifPend -- "no" --> Revalidar --> Carrera
    Carrera -- "no" --> AbortC
    Carrera -- "sí" --> IterApply --> TipoApply
    TipoApply -- "sheet" --> Matriz
    Matriz --> BatchUp --> UpdSnap
    Matriz --> WriteBack --> UpdSnap
    TipoApply -- "doc"   --> LeerMd --> Pandoc --> UploadDoc --> UpdSnap
    UpdSnap --> AppFin

    %% =========================================
    %%  Flujos de datos
    %% =========================================
    Manifest -. lee .-> Cargar
    State    -. lee snapshot .-> Cargar
    Drive    -. valores · fórmulas · notas · comentarios .-> FetchSheet
    Drive    -. modifiedTime .-> FetchDoc
    LocalFiles -. lee CSV .-> DiffCel
    LocalFiles -. lee MD .-> Transforms
    EscribSal -. escribe artefactos .-> Preview
    EscribSal -. escribe pendientes · drifts .-> Decisions

    Decisions -. lee .-> VerifPend
    Drive    -. re-fetch .-> Revalidar
    Preview  -. lee diff de valores .-> Matriz
    Decisions -. lee resoluciones .-> Matriz
    BatchUp  -. escribe valores .-> Drive
    WriteBack -. reescribe CSV .-> LocalFiles
    Preview  -. lee MD .-> LeerMd
    UploadDoc -. update doc .-> Drive
    UpdSnap  -. actualiza .-> State

    %% =========================================
    %%  Coreografía entre procesos · eventos
    %% =========================================
    Decisions -. evento · pendientes detectados .-> RevIni
    Decisions -. evento · resueltas .-> AppIni

    %% =========================================
    %%  Estilos
    %% =========================================
    classDef inicio    fill:#c8e6c9,stroke:#2e7d32,color:#000;
    classDef fin       fill:#ffcdd2,stroke:#c62828,color:#000;
    classDef actividad fill:#bbdefb,stroke:#1565c0,color:#000;
    classDef gateway   fill:#fff9c4,stroke:#f9a825,color:#000;
    classDef io        fill:#e0e0e0,stroke:#616161,color:#000;
    classDef ioExt     fill:#f5f5f5,stroke:#616161,stroke-dasharray:5 5,color:#000;

    class PlanIni,RevIni,AppIni inicio;
    class PlanFin,RevFin,AppFin,AbortP,AbortC fin;
    class Cargar,IterPlan,FetchSheet,RegDrift,DiffCel,AutoForm,PlanPush,PlanWB,RegPend,FetchDoc,RegDriftDoc,Transforms,EscribMd,EscribSal,Resumir,Responder,Editar,Revalidar,IterApply,Matriz,BatchUp,WriteBack,LeerMd,Pandoc,UploadDoc,UpdSnap actividad;
    class TipoPlan,DiffStruct,ClasCel,DiffDoc,VerifPend,Carrera,TipoApply gateway;
    class Manifest,State,Preview,Decisions,LocalFiles io;
    class Drive ioExt;
