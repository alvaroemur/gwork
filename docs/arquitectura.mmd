%% cowork-drivesync - DFD nivel 1 (v2)
%% Incorpora: gog-cli como capa de acceso a Workspace,
%%            design system como config de formato post-upload,
%%            apps script menu como paso de attach en primer upload.
%% Leyenda:
%%   [Nombre]          entidad externa
%%   [actividad]       proceso del sistema
%%   [(store)]         store interno
%%   [(store)] dashed  store externo
%%   -->               flujo de control
%%   -.->              flujo de datos

    %% --- entidades externas ---
    Usuario[Álvaro vía agente Claude Code]
    Drive[(Google Drive · Sheets · Docs · Slides)]
    GogCli[gog-cli]
    Pandoc[Pandoc CLI]
    GitHook[Git post-commit hook]

    %% --- procesos del sistema ---
    subgraph S[" cowork-drivesync "]
        direction TB
        Plan[sync plan]
        Apply[sync apply · push + write-back]
        Format[format · apply design system]
        MenuScript[attach apps script menu]
    end

    %% --- stores internos ---
    Manifest[(.drivesync.yaml)]
    State[(.drivesync.state.json)]
    Preview[(.drivesync/preview/)]
    Decisions[(.drivesync/preview/decisions.yaml)]
    DesignSystem[(.claude-design.yaml)]
    LocalFiles[(CSV + MD locales · entregables)]

    %% --- flujos de control ---
    Usuario -- "sync plan" --> Plan
    Usuario -- "sync apply" --> Apply
    GitHook -. avisa .-> Usuario

    %% --- flujos de datos: plan ---
    Manifest -. lee .-> Plan
    LocalFiles -. lee .-> Plan
    State -. lee snapshot .-> Plan
    Plan -. fetch valores · notas · comentarios .-> GogCli
    GogCli -. respuesta .-> Plan
    Plan -. escribe artefactos transformados .-> Preview
    Plan -. escribe pendientes y drifts .-> Decisions

    %% --- flujos de datos: apply ---
    Manifest -. lee .-> Apply
    State -. lee snapshot .-> Apply
    Preview -. lee artefactos .-> Apply
    Decisions -. lee decisiones resueltas .-> Apply
    LocalFiles -. lee MD original .-> Apply
    Apply -. MD a docx .-> Pandoc
    Pandoc -. docx .-> Apply
    Apply -. batchUpdate · upload · re-fetch .-> GogCli
    Apply -. write-back de celdas .-> LocalFiles
    Apply -. actualiza snapshot .-> State

    %% --- flujos de datos: format ---
    Apply -- "post-upload" --> Format
    DesignSystem -. lee estilos · paleta · tipografía .-> Format
    Format -. batchUpdate de formato .-> GogCli

    %% --- flujos de datos: menu script ---
    Apply -- "primer upload" --> MenuScript
    MenuScript -. genera y bindea apps script .-> GogCli

    %% --- gog-cli habla con Drive ---
    GogCli -. API calls · OAuth gestionado .-> Drive

    %% --- flujos de datos: hook ---
    LocalFiles -. detecta cambios en commits .-> GitHook

    %% --- estilos ---
    classDef inicio    fill:#c8e6c9,stroke:#2e7d32,color:#000;
    classDef fin       fill:#ffcdd2,stroke:#c62828,color:#000;
    classDef actividad fill:#bbdefb,stroke:#1565c0,color:#000;
    classDef gateway   fill:#fff9c4,stroke:#f9a825,color:#000;
    classDef io        fill:#e0e0e0,stroke:#616161,color:#000;
    classDef ioExt     fill:#f5f5f5,stroke:#616161,stroke-dasharray:5 5,color:#000;
    classDef externa   fill:#ffffff,stroke:#424242,color:#000;

    class Plan,Apply,Format,MenuScript actividad;
    class Usuario,Pandoc,GogCli,GitHook externa;
    class Drive ioExt;
    class Manifest,State,Preview,Decisions,DesignSystem,LocalFiles io;
